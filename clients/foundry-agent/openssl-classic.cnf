# Workaround for "[SSL: UNEXPECTED_EOF_WHILE_READING]" from Python on OpenSSL 3.5 or later when it calls the Foundry
# project endpoint (*.services.ai.azure.com): OpenSSL's default TLS 1.3 handshake offers a post-quantum hybrid key
# share that some endpoints and network devices drop. This keeps TLS 1.3 with classic key exchange groups.
#   OPENSSL_CONF=clients/foundry-agent/openssl-classic.cnf python clients/foundry-agent/agent.py
openssl_conf = openssl_init
[openssl_init]
ssl_conf = ssl_sect
[ssl_sect]
system_default = system_default_sect
[system_default_sect]
Groups = X25519:P-256:P-384
